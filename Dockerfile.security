FROM snipe/snipe-it:v8.3.7

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       --only-upgrade \
       php8.3-common \
       php8.3-cli \
       libapache2-mod-php8.3 \
       php8.3-opcache \
       php8.3-curl \
       php8.3-mbstring \
       php8.3-mysql \
       php8.3-xml \
       php8.3-gd \
       php8.3-zip \
       php8.3-bcmath \
       php8.3-ldap \
    && dpkg --compare-versions \
       "$(dpkg-query -W -f='${Version}' libapache2-mod-php8.3)" \
       ge 8.3.6-0ubuntu0.24.04.13 \
    && rm -rf /var/lib/apt/lists/*
